# Copy to .env locally. Do not put secrets in git.

# Workflow persistence (SQLite locally; Postgres URL works later)
# DATABASE_URL=sqlite:///./kiyub_workflow.db
# JWT_SECRET=change-me-in-production
# JWT_HOURS=72
# KIYUB_WORKFLOW_STUB_GENERATE=0

# Backend (optional)
# KIYUB_HOUSEGAN_REMOTE_ENABLED=0
# KIYUB_MULTI_STRATEGY=1
# KIYUB_SPATIAL_PLANNER=1
# KIYUB_BUILDING_MASS=1
# KIYUB_CLUSTERS=1
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Ollama (RAG / chat) — default
# OLLAMA is expected at http://localhost:11434 when those features are used.

# Frontend Vite proxies /api to http://127.0.0.1:8002 (see frontend/vite.config.ts).
