# Copy to .env locally. Do not put secrets in git.

# Supabase (required for production workflow persistence)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local JWT verify instead of Auth get_user()
# SUPABASE_JWT_SECRET=

# Public site URL used in invitation emails (no trailing slash).
# Development may use http://localhost:5173.
# Production MUST set this to https://your-production-domain — the API will
# refuse to send invites if this is missing or localhost while Supabase is enabled.
PUBLIC_APP_URL=https://your-production-domain
# REJECTION_MAIL_SECRET=  # shared with supabase/functions/architect-rejection

# Frontend Vite (never put the service role here)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Workflow
# KIYUB_WORKFLOW_STUB_GENERATE=0
# KIYUB_WORKFLOW_MEMORY=1 is pytest-only. Do not set it when running uvicorn.

# Backend (optional)
# KIYUB_HOUSEGAN_REMOTE_ENABLED=0
# KIYUB_MULTI_STRATEGY=1
# KIYUB_SPATIAL_PLANNER=1
# KIYUB_BUILDING_MASS=1
# KIYUB_CLUSTERS=1
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Ollama (RAG / chat) — default
# OLLAMA is expected at http://localhost:11434 when those features are used.

# Frontend Vite proxies /api to http://127.0.0.1:8002 (see frontend/vite.config.ts).
